# Telegram API Credentials
# Get these from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here

# Pyrogram Session String
# Generate this using a script or standard Pyrogram tools
SESSION_STRING=your_pyrogram_session_string_here

# Terabox Cookie
# Log in to Terabox, inspect cookies, and copy the value of 'ndus'
TERABOX_NDUS=your_terabox_ndus_cookie_here
