# Telegram Bot Configuration
# Get API_ID and API_HASH from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here

# Bot Token
# Get this from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Owner ID
# Your numerical Telegram User ID (get from @userinfobot)
# The bot will only respond to this user
OWNER_ID=123456789

# Terabox Cookie
TERABOX_NDUS=your_terabox_ndus_cookie_here
TERABOX_ACCESS_TOKEN=your_premium_access_token_here

# API Notification (Optional)
ENABLE_API_UPLOAD=false
API_URL=https://your-api.com/endpoint
API_USERNAME=your_username
API_SECRET=your_jwt_secret

# Queue Settings
MAX_CONCURRENT_DOWNLOADS=2
